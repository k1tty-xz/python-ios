#!@SHELL@
set -e

case "${1-}" in
    remove|purge)
        # Remove only package-specific directories, and only when empty.
        rmdir @INSTALL_PREFIX@/Frameworks/Python.framework 2>/dev/null || :
        rmdir @INSTALL_PREFIX@/Frameworks/include 2>/dev/null || :
        rmdir @INSTALL_PREFIX@/Frameworks/bin 2>/dev/null || :
        ;;
esac

exit 0
