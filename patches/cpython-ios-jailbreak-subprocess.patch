@@ -1,6 +1,9 @@
 import sys
 try:
-    from ctypes import cdll, c_void_p, c_char_p, util
+    from ctypes import (
+        POINTER, byref, cdll, c_char_p, c_int, c_size_t, c_void_p,
+        create_string_buffer, util,
+    )
 except ImportError:
     # ctypes is an optional module. If it's not present, we're limited in what
     # we can tell about the system, but we don't want to prevent the module
@@ -10,18 +13,44 @@
 else:
     # ctypes is available. Load the ObjC library, and wrap the objc_getClass,
     # sel_registerName methods
-    lib = util.find_library("objc")
-    if lib is None:
-        # Failed to load the objc library
-        raise ImportError("ObjC runtime library couldn't be loaded")
+    # find_library() cannot resolve the dyld shared cache on older iOS.
+    lib = util.find_library("objc") or "libobjc.dylib"
 
-    objc = cdll.LoadLibrary(lib)
+    try:
+        objc = cdll.LoadLibrary(lib)
+    except OSError:
+        raise ImportError("ObjC runtime library couldn't be loaded")
     objc.objc_getClass.restype = c_void_p
     objc.objc_getClass.argtypes = [c_char_p]
     objc.sel_registerName.restype = c_void_p
     objc.sel_registerName.argtypes = [c_char_p]
 
 
+def _get_product_version():
+    if not objc:
+        return ""
+
+    try:
+        lib = util.find_library("c") or "libSystem.dylib"
+        system = cdll.LoadLibrary(lib)
+        sysctlbyname = system.sysctlbyname
+        sysctlbyname.restype = c_int
+        sysctlbyname.argtypes = [
+            c_char_p, c_void_p, POINTER(c_size_t), c_void_p, c_size_t,
+        ]
+        size = c_size_t()
+        if sysctlbyname(b"kern.osproductversion", None, byref(size), None, 0):
+            return ""
+        value = create_string_buffer(size.value)
+        if sysctlbyname(
+            b"kern.osproductversion", value, byref(size), None, 0
+        ):
+            return ""
+        return value.value.decode("ascii")
+    except (AttributeError, OSError, ValueError, UnicodeDecodeError):
+        return ""
+
+
 def get_platform_ios():
     # Determine if this is a simulator using the multiarch value
     is_simulator = sys.implementation._multiarch.endswith("simulator")
@@ -38,8 +67,13 @@ def get_platform_ios():
     # Equivalent of:
     #   device = [UIDevice currentDevice]
     UIDevice = objc.objc_getClass(b"UIDevice")
+    if not UIDevice:
+        return "iOS", _get_product_version(), "", is_simulator
+
     SEL_currentDevice = objc.sel_registerName(b"currentDevice")
     device = objc.objc_msgSend(UIDevice, SEL_currentDevice)
+    if not device:
+        return "iOS", _get_product_version(), "", is_simulator
 
     # Equivalent of:
     #   device_systemVersion = [device systemVersion]
@@ -64,8 +98,16 @@ def get_platform_ios():
     #   system = [device_systemName UTF8String]
     #   release = [device_systemVersion UTF8String]
     #   model = [device_model UTF8String]
-    system = objc.objc_msgSend(device_systemName, SEL_UTF8String).decode()
-    release = objc.objc_msgSend(device_systemVersion, SEL_UTF8String).decode()
-    model = objc.objc_msgSend(device_model, SEL_UTF8String).decode()
+    def decode(value):
+        if not value:
+            return ""
+        value = objc.objc_msgSend(value, SEL_UTF8String)
+        return value.decode() if value else ""
+
+    system = decode(device_systemName) or "iOS"
+    release = decode(device_systemVersion)
+    if not release:
+        release = _get_product_version()
+    model = decode(device_model)
 
     return system, release, model, is_simulator
