diff --git a/Lib/_ios_support.py b/Lib/_ios_support.py
--- a/Lib/_ios_support.py
+++ b/Lib/_ios_support.py
@@ -26,6 +26,10 @@ def get_platform_ios():
     # Equivalent of:
     #   device = [UIDevice currentDevice]
     UIDevice = objc.objc_getClass(b"UIDevice")
+    # ios-cli-platform-fallback: UIKit may be unavailable to CLI processes.
+    if not UIDevice:
+        return None
+
     SEL_currentDevice = objc.sel_registerName(b"currentDevice")
     device = objc.objc_msgSend(UIDevice, SEL_currentDevice)
+    if not device:
+        return None
 
     # Equivalent of:
     #   device_systemVersion = [device systemVersion]
@@ -43,6 +47,9 @@ def get_platform_ios():
     SEL_model = objc.sel_registerName(b"model")
     device_model = objc.objc_msgSend(device, SEL_model)
 
+    if not all((device_systemVersion, device_systemName, device_model)):
+        return None
+
     # UTF8String returns a const char*;
     SEL_UTF8String = objc.sel_registerName(b"UTF8String")
     objc.objc_msgSend.restype = c_char_p
@@ -53,9 +60,15 @@ def get_platform_ios():
     #   system = [device_systemName UTF8String]
     #   release = [device_systemVersion UTF8String]
     #   model = [device_model UTF8String]
-    system = objc.objc_msgSend(device_systemName, SEL_UTF8String).decode()
-    release = objc.objc_msgSend(device_systemVersion, SEL_UTF8String).decode()
-    model = objc.objc_msgSend(device_model, SEL_UTF8String).decode()
+    system = objc.objc_msgSend(device_systemName, SEL_UTF8String)
+    release = objc.objc_msgSend(device_systemVersion, SEL_UTF8String)
+    model = objc.objc_msgSend(device_model, SEL_UTF8String)
+    if not all((system, release, model)):
+        return None
 
-    return system, release, model, is_simulator
+    return system.decode(), release.decode(), model.decode(), is_simulator
